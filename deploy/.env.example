# ============================================================
# Ginger Studios & Creatives — Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# ── Database ──────────────────────────────────────────────
# MySQL connection string for your hosting provider
# Format: mysql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL=mysql://db_user:db_password@localhost:3306/ginger_studios

# ── Security ──────────────────────────────────────────────
# Session secret — generate a strong random string (32+ characters)
# Run this to generate one: openssl rand -base64 32
SESSION_SECRET=change-this-to-a-long-random-secret-string

# ── Admin Credentials ─────────────────────────────────────
# These are used if no admin record exists in the database.
# After first login, update via Admin → Settings.
ADMIN_EMAIL=admin@yourdomain.com

# SHA-256 hex hash of your admin password.
# Generate: echo -n "YourPassword123!" | sha256sum
# Default password is: GingerStudios2026!
ADMIN_PASSWORD_HASH=afc30d616ab1a3a18c64e90c2f2d77c3aa2b0e396e2c55b37e80d1d09d3e5b2f

# ── Storage ───────────────────────────────────────────────
# Use "local" to store uploads on this server's filesystem
STORAGE_MODE=local

# Absolute path to the folder where uploaded files will be stored
# This folder must exist and be writable by the Node.js process
UPLOADS_DIR=/var/www/ginger-studios/uploads

# ── Server ────────────────────────────────────────────────
NODE_ENV=production

# Port the Node.js app listens on internally
# Your Nginx/Apache config should proxy to this port
PORT=3001
