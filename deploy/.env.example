# ─── Required ────────────────────────────────────────────────────────────────

# PostgreSQL connection string
DATABASE_URL=postgres://user:password@localhost:5432/ginger_studios

# Secret used to sign admin session tokens — pick any long random string
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# ─── Admin credentials ────────────────────────────────────────────────────────
# Email the admin uses to log in
ADMIN_EMAIL=admin@yourdomain.com

# SHA-256 hex hash of the admin password.
# Generate with:  node -e "const{createHash}=require('crypto');console.log(createHash('sha256').update('YourPassword').digest('hex'))"
ADMIN_PASSWORD_HASH=f332fe25fa2eecfc3e58d7fa337f918b5d3fabe9ec9379a5149f17d9e74c3174

# ─── Storage (choose one mode) ────────────────────────────────────────────────

# 'local'  — store uploaded images on disk (simplest, works on any server)
# 'replit' — Replit managed GCS (only if running on Replit)
STORAGE_MODE=local

# Directory where uploaded images are saved (local mode only).
# Must be writable by the Node.js process.
# Use an absolute path, e.g. /var/www/ginger-studios/uploads
UPLOADS_DIR=./uploads

# ─── Optional ────────────────────────────────────────────────────────────────

# Port the server listens on (default: 8080)
PORT=8080

# Node environment
NODE_ENV=production
