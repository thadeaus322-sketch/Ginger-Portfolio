# ──────────────────────────────────────────────────────────────────
# Ginger Studios — Server Environment Variables
# Place this file at:  /home/gvscomng/public_html/ginger/server/.env
# ──────────────────────────────────────────────────────────────────

# MySQL database connection (required)
DATABASE_URL=mysql://gvscomng_ginger:Adenike12$@localhost:3306/gvscomng_admin

# Storage: use 'local' for self-hosted servers
STORAGE_MODE=local

# Absolute path where uploaded images will be saved (must be writable)
UPLOADS_DIR=/home/gvscomng/public_html/ginger/uploads

# Secret used to sign session cookies — change this to any long random string
SESSION_SECRET=change-this-to-a-long-random-secret-string

# Node environment
NODE_ENV=production
