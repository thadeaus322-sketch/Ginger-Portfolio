Options -Indexes

# ── Compression ──────────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>

# ── Caching ───────────────────────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  <FilesMatch "\.(js|css)$">
    ExpiresDefault "access plus 1 year"
  </FilesMatch>
  <FilesMatch "\.(jpg|jpeg|png|gif|svg|webp|ico|mp4|woff2|woff|ttf)$">
    ExpiresDefault "access plus 1 month"
  </FilesMatch>
</IfModule>

# ── SPA routing ───────────────────────────────────────────────────────────────
# CRITICAL: check real files/dirs first, then fall back to index.html.
# Without -f / -d guards, every /images/*.jpg request gets served index.html
# instead of the actual image file — making all images invisible.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^ index.html [L]
</IfModule>
